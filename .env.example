# Optional. Without a key the app still runs: tools (OSM/Overpass, search,
# geocoding, proximity) work, and a keyword supervisor routes between agents.
# With a key, the supervisor and specialist agents use an LLM.

# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alert radius in meters for "you are near a reported camera"
ALERT_RADIUS_METERS=400

# Default OSM search radius when looking up a city or point
SEARCH_RADIUS_METERS=5000
